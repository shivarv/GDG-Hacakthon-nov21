# LLM: anthropic | openai | none   (none = extractive drafts, no API key needed)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=...
# For OpenAI-compatible endpoints (OpenAI, Groq, Together, local Ollama):
# LLM_PROVIDER=openai
# LLM_MODEL=llama3.1:8b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

EMBED_MODEL=intfloat/multilingual-e5-small
TOP_K=5
CONF_THRESHOLD=0.45
# SIM_THRESHOLD=0.82
BURST_SIM=0.88
BURST_MIN=3
BURST_WINDOW_MIN=15
LANGUAGES=en,de
# DATASET_CSV=data/dataset-tickets-multi-lang-4-20k.csv
