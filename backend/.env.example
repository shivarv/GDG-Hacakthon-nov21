DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# IMAP email listener
EMAIL_LISTENER_ENABLED=true
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_USE_SSL=false
IMAP_USERNAME=support@helpdesk.local
IMAP_PASSWORD=support
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=10

# Temporary public inbox (mail.tm): receive real email from Gmail etc.
# with no domain or public server. The address is shown on the Email Inbox page.
TEMP_INBOX_ENABLED=false
TEMP_INBOX_POLL_INTERVAL_SECONDS=10

# Outbound acknowledgement emails
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_FROM_ADDRESS=support@helpdesk.local
SUPPORT_FROM_NAME=HelpDesk Support
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USE_TLS=true
# SMTP_USERNAME=your.support@gmail.com SMTP_PASSWORD=<app password>
