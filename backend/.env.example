# Copy to backend/.env and fill in. backend/.env is gitignored.
# Start the backend:  cd backend && uvicorn app.main:app --reload --reload-include .env

# ---- FILL IN: outgoing email through Brevo ----
BREVO_API_KEY=                      # xkeysib-... (Brevo -> SMTP & API -> API Keys)
SUPPORT_FROM_ADDRESS=               # sender verified in that Brevo account
SUPPORT_FROM_NAME=HelpDesk Support

# ---- Triage + escalation ----
AUTO_ESCALATE=true                  # escalate severe new email tickets automatically
TRIAGE_MODEL=sentinel               # dummy | sentinel (Cloud Run) | sentinel_local (pip install -r requirements-model.txt)
TRIAGE_URL=https://sentinel-triage-mx2zqqjdda-uc.a.run.app
ETA_MODEL=dummy                     # resolution-time model (dummy until a trained model is merged)
SUPPORT_TIMEZONE=America/New_York   # timezone shown to customers

# ---- Already set ----
DATABASE_URL=sqlite:///./.data/helpdesk.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
TEMP_INBOX_ENABLED=true             # free public inbox via mail.tm
TEMP_INBOX_POLL_INTERVAL_SECONDS=10
EMAIL_LISTENER_ENABLED=false        # IMAP polling (GreenMail in Docker)

# ---- Optional: SMTP instead of the Brevo API ----
# SMTP_ENABLED=true
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=<Brevo SMTP login>
# SMTP_PASSWORD=<Brevo SMTP key>
