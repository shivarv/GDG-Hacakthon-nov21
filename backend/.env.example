DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# IMAP email listener
EMAIL_LISTENER_ENABLED=true
IMAP_HOST=localhost
IMAP_PORT=3143
IMAP_USE_SSL=false
IMAP_USERNAME=support@helpdesk.local
IMAP_PASSWORD=support
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=10

# Outbound acknowledgement emails
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=3025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SUPPORT_FROM_ADDRESS=support@helpdesk.local
